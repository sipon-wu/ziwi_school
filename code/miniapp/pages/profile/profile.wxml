<!-- 个人中心 -->
<view class="page">
  <view class="header">
    <view class="avatar">{{userName[0] || '学'}}</view>
    <text class="name">{{userName || '学生'}}</text>
    <text class="school">{{schoolName || ''}}</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goPersonal">
      <text>个人信息</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goReport">
      <text>学习报告</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text>设置</text>
      <text class="arrow">></text>
    </view>
  </view>

  <button class="logout-btn" bindtap="handleLogout">退出登录</button>
</view>
