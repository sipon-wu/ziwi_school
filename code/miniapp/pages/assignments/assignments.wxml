<!-- 作业列表 -->
<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <block wx:else>
    <view wx:if="{{items.length === 0}}" class="empty">暂无作业</view>
    <view wx:else>
      <view class="card" wx:for="{{items}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}">
        <view class="flex-between">
          <view>
            <text class="title">{{item.title}}</text>
            <text class="subtitle">{{item.subject}} · 剩余{{item.due_hours}}小时</text>
          </view>
          <text class="tag {{item.status === 'submitted' ? 'tag-success' : 'tag-warning'}}">
            {{item.status === 'submitted' ? '已提交' : '待完成'}}
          </text>
        </view>
      </view>
    </view>
  </block>
</view>
