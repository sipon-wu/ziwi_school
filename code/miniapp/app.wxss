/* app.wxss — 全局样式，对齐品牌设计系统 */
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #353535;
  background-color: #f5f5f5;
}

/* 品牌色 */
.brand-blue { color: #02A7F0; }
.bg-brand { background-color: #02A7F0; }

/* 卡片 */
.card {
  background: #fff;
  border: 1rpx solid #E7E7EB;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
}
.tag-success { background: rgba(82,196,26,0.10); color: #52C41A; }
.tag-warning { background: rgba(246,146,14,0.10); color: #F6920E; }
.tag-danger { background: rgba(255,77,79,0.10); color: #FF4D4F; }
.tag-default { background: #f0f0f0; color: #9A9A9A; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #A3A3A3;
  font-size: 28rpx;
}
