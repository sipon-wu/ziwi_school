# ═══════════════════════════════════════════
# 知微教学平台 · 环境变量模板
# 复制为 .env 并填入真实值
# ═══════════════════════════════════════════

# ── 数据库 ──
DB_USER=zhiwei
DB_PASSWORD=zhiwei123
DB_NAME=zhiwei_school
DB_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── 后端 ──
BACKEND_PORT=8080
JWT_SECRET=change-me-in-production-use-random-64-chars

# ── AI 服务 ──
AI_PORT=8000
# 通义千问 API Key (从阿里云百炼获取: https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=sk-your-api-key-here

# ── Nginx ──
NGINX_PORT=80

# ── OSS (可选) ──
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
